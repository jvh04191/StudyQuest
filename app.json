{
  "expo": {
    "name": "StudyQuest",
    "slug": "studyquest",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "studyquest",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3E9D6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyquest.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3E9D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "name": "StudyQuest",
      "shortName": "StudyQuest",
      "description": "A cozy RPG study app: turn notes into flashcards, tests and quests.",
      "themeColor": "#4E7D43",
      "backgroundColor": "#F3E9D6",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E9D6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
