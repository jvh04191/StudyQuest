# Copy this file to `.env` and fill in ONE key to turn on Nova's AI tutoring,
# note-to-flashcard generation and PDF reading.
# Keys stay on your computer: only the Expo server reads them, never the app.

# --- Option 1: Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Backup model(s) used automatically when the main one is busy (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash

# --- Option 2: Anthropic Claude ---
# Get a key at https://console.anthropic.com, then set AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Hosted web app (private, synced across your devices) ---
# Set these on your host (e.g. Vercel) before sharing the URL with yourself:
# ACCESS_CODE=pick-a-long-passphrase       # locks the API and turns on cloud sync
# UPSTASH_REDIS_REST_URL=                  # free database at https://upstash.com (Redis -> REST API)
# UPSTASH_REDIS_REST_TOKEN=
# Without Upstash, synced progress is saved to .data/state.json (fine on your PC, not on serverless hosts).
